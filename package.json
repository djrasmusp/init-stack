{
  "name": "init-stack",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "author": {
    "name": "Rasmus P",
    "email": "hello@rasmusp.com",
    "url": "https://rasmusp.com"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t init-stack .",
    "docker:run": "docker run -p 8080:80 --name init-stack-container init-stack",
    "docker:stop": "docker stop init-stack-container && docker rm init-stack-container"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@commitlint/types": "^20.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "globals": "^16.5.0",
    "lefthook": "^2.0.15",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.3.1"
    },
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
